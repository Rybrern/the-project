rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo de wallpapers: lectura pública, escritura solo desde
    // Cloud Functions (Admin SDK, que ignora estas reglas).
    match /wallpapers/{wallpaperId} {
      allow read: if true;
      allow write: if false;
    }

    match /ingestion_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
