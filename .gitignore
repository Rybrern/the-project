# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local API keys — never commit real secrets.
# wallhaven_config.dart contiene la key real; se genera via --dart-define o copia local.
/lib/config/wallhaven_config.dart
/lib/config/media_api_config.dart
# Firebase — restringir keys en consola y no exponer json si el repo es público
/android/app/google-services.json
/android/app/google-services-*.json
/ios/Runner/GoogleService-Info.plist
/ios/GoogleService-Info.plist
# Fallback: cualquier *_config.dart con secretos (excepto .example)
lib/config/*_config.dart
!lib/config/*.example.dart
# Supabase publishable key es pública (RLS protege escritura) — se puede commitear
!lib/config/supabase_config.dart
