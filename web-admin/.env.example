# Copiar a .env.local (nunca commitear el archivo real) y completar con
# los valores reales del Dashboard de Supabase y un secreto propio.

NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — NUNCA con prefijo NEXT_PUBLIC_. Da acceso total a la base,
# sin RLS. Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Contraseña propia para /admin y /admin/pendientes. Cualquier string largo
# y aleatorio sirve — no tiene que ser memorizable.
ADMIN_SECRET=cambiame-por-algo-largo-y-aleatorio
