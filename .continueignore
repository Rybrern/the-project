# Evita que Continue indexe artefactos de build, dependencias y binarios:
# sin esto, el índice de "codebase" se llena de ruido (código generado,
# .dart_tool, gradle caches) que nunca es útil como contexto y hace la
# búsqueda más lenta e imprecisa.

.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
.gradle/
android/.gradle/
android/app/build/
android/build/
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework/
ios/Flutter/Flutter.podspec
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart
.idea/
.vscode/
*.iml
*.log
*.lock
pubspec.lock

# Nunca deben terminar en el índice ni mandarse como contexto al modelo.
lib/config/wallhaven_config.dart
lib/config/media_api_config.dart
